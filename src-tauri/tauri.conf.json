{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADB Wireless Device Farm",
  "version": "0.1.9",
  "identifier": "com.endrisusanto.adb-wireless-device-farm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ternak Buzzer",
        "width": 1920,
        "height": 1080,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
